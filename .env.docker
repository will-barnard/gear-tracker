# Database Configuration
DB_PASSWORD=your_secure_password_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRE=2y

# Frontend API URL (adjust for your NAS IP)
CORS_ORIGIN=http://your-nas-ip
VITE_API_URL=http://your-nas-ip:3000/api

# Owner's timezone ("today", backup hour)
APP_TIMEZONE=America/Chicago

# Photos/receipts/PDFs in brew-bucket — key: read+write+delete on uploads only
BREW_BUCKET_URL=https://your-brew-bucket
BREW_BUCKET_KEY=

# Nightly DB backup to brew-bucket — key: read+write on backups only
BACKUP_BREW_BUCKET_KEY=

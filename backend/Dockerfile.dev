FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy source code
COPY . .

# Make entrypoint script executable
RUN chmod +x docker-entrypoint.sh

# Expose port
EXPOSE 3000

# Use entrypoint script (waits for postgres; the server applies migrations on boot)
ENTRYPOINT ["./docker-entrypoint.sh"]
CMD ["npm", "run", "dev"]
